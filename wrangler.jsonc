{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-20",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "hgshop",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "hgstoremx.com",
			"zone_name": "hgstoremx.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"vars": {
		"SANITY_PROJECT_ID": "lit3j3pr"
	},
	// Limitador de solicitudes de Cloudflare: no gasta escrituras de KV (el plan gratis
	// permite 1,000 al día y antes cada llamada admin se comía una).
	"ratelimits": [
		{
			"name": "LIMITE",
			"namespace_id": "1001",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "32b3fae3378f49fbaefaa7b2b96b4f5f"
		}
	],
	"workers_dev": false,
	"preview_urls": false
}
