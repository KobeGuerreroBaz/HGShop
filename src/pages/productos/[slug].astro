---
import { sanityClient, urlFor, obtenerConfiguracionWhatsApp, numeroWhatsAppParaDepartamento, nombreDepartamento } from '../../lib/sanity';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const productos = await sanityClient.fetch(`
    *[_type == "producto" && defined(slug.current)]{
      "slug": slug.current
    }
  `);

  return productos.map((producto: any) => ({
    params: { slug: producto.slug },
  }));
}

const { slug } = Astro.params;

const producto = await sanityClient.fetch(
  `*[_type == "producto" && slug.current == $slug][0]{
    titulo,
    precio,
    estado,
    descripcion,
    altTexto,
    imagenPrincipal,
    galeria,
    edicion,
    capacidad,
    marca,
    edadRecomendada,
    palabrasClave,
    mostrarExistencias,
    cantidadDisponible,
    agotado,
    "categoriaTitulo": categoria->titulo,
    "categoriaDepartamento": categoria->departamento
  }`,
  { slug }
);

const textoAlt = producto.altTexto || producto.titulo;

const TEXTO_ENTREGA = 'Entrega personal en Monterrey, envío disponible a toda la República Mexicana';
const descripcionCompleta = producto.descripcion
  ? `${producto.descripcion}\n\n${TEXTO_ENTREGA}`
  : TEXTO_ENTREGA;

const LIMITE_META = 155;
const descripcionBase = producto.descripcion || TEXTO_ENTREGA;
const descripcionMeta =
  descripcionBase.length > LIMITE_META
    ? `${descripcionBase.slice(0, LIMITE_META - 1).trimEnd()}…`
    : descripcionBase;

const configWhatsApp = await obtenerConfiguracionWhatsApp();
const numeroWhatsApp = numeroWhatsAppParaDepartamento(producto.categoriaDepartamento, configWhatsApp);
const nombreDepartamentoTexto = nombreDepartamento(producto.categoriaDepartamento, configWhatsApp);

const linkProducto = `https://hgstoremx.com/productos/${slug}`;
const mensaje = `Hola, me interesa: ${producto.titulo}${producto.edicion ? ` (${producto.edicion})` : ''}\n\n${linkProducto}`;
const linkWhatsApp = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(mensaje)}`;

const linkVolverRespaldo = `/catalogo/${producto.categoriaDepartamento}`;

const imagenPrincipalUrl = urlFor(producto.imagenPrincipal).width(800).url();

const galeria = (producto.galeria || []).map((img: any) => ({
  miniatura: urlFor(img).width(200).url(),
  completa: urlFor(img).width(800).url(),
}));

const todasLasFotos = [
  { miniatura: urlFor(producto.imagenPrincipal).width(200).url(), completa: imagenPrincipalUrl },
  ...galeria,
];

const mostrarBadgeExistencias =
  producto.mostrarExistencias && producto.cantidadDisponible !== undefined && producto.cantidadDisponible !== null;
const pocasPiezas = mostrarBadgeExistencias && producto.cantidadDisponible <= 2;

const disponibilidad = producto.agotado
  ? 'https://schema.org/OutOfStock'
  : producto.cantidadDisponible !== undefined && producto.cantidadDisponible !== null && producto.cantidadDisponible <= 0
    ? 'https://schema.org/OutOfStock'
    : 'https://schema.org/InStock';

const datosEstructurados = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: producto.titulo,
  image: [imagenPrincipalUrl, ...galeria.map((g: { completa: string }) => g.completa)],
  description: descripcionMeta,
  ...(producto.marca ? { brand: { '@type': 'Brand', name: producto.marca } } : {}),
  offers: {
    '@type': 'Offer',
    url: linkProducto,
    priceCurrency: 'MXN',
    price: producto.precio,
    availability: disponibilidad,
  },
};

const datosBreadcrumb = {
  '@context': 'https://schema.org/',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://hgstoremx.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nombreDepartamentoTexto,
      item: `https://hgstoremx.com/catalogo/${producto.categoriaDepartamento}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: producto.titulo,
      item: linkProducto,
    },
  ],
};
---
<Layout
  titulo={`${producto.titulo} - HG Shop MX`}
  descripcion={descripcionMeta}
  imagen={imagenPrincipalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <script type="application/ld+json" set:html={JSON.stringify(datosBreadcrumb)} />
  </Fragment>

  <main class="px-6 py-12 max-w-3xl mx-auto">
    <a id="enlace-volver" href={linkVolverRespaldo} data-departamento={nombreDepartamentoTexto} class="text-sm text-neutral-500 hover:text-neutral-900">
      &larr; Volver a {nombreDepartamentoTexto}
    </a>

    <div class="mt-6 grid md:grid-cols-2 gap-10">
      <div id="galeria-producto" data-fotos={JSON.stringify(todasLasFotos.map((f) => f.completa))}>
        <div class="aspect-square w-full overflow-hidden rounded-xl bg-neutral-50 border border-neutral-100">
          <img
            id="imagen-principal"
            src={imagenPrincipalUrl}
            alt={textoAlt}
            class={`w-full h-full object-contain cursor-zoom-in ${producto.agotado ? 'opacity-50 grayscale' : ''}`}
          />
        </div>

        {todasLasFotos.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-2">
            {todasLasFotos.map((foto) => (
              <button
                type="button"
                class="miniatura aspect-square overflow-hidden rounded-lg bg-neutral-50 border border-neutral-100 hover:border-neutral-400 transition-colors"
                data-full={foto.completa}
              >
                <img src={foto.miniatura} alt={textoAlt} class="w-full h-full object-contain" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div>
        {producto.categoriaTitulo && (
          <p class="text-xs uppercase tracking-wide text-neutral-400">{producto.categoriaTitulo}</p>
        )}
        <h1 class="mt-1 text-2xl font-semibold text-neutral-900">{producto.titulo}</h1>
        <p class="mt-3 text-2xl font-semibold text-neutral-900">${producto.precio} MXN</p>

        {producto.agotado ? (
          <p class="mt-2 inline-block text-xs font-medium px-2 py-1 rounded-full bg-neutral-100 text-neutral-600">
            Agotado
          </p>
        ) : mostrarBadgeExistencias && (
          <p class={`mt-2 inline-block text-xs font-medium px-2 py-1 rounded-full ${pocasPiezas ? 'bg-amber-50 text-amber-700' : 'bg-green-50 text-green-700'}`}>
            {pocasPiezas ? '¡Pocas piezas!' : 'Disponible'}
          </p>
        )}

        <p class="mt-4 text-neutral-600 leading-relaxed whitespace-pre-line">{descripcionCompleta}</p>

        <dl class="mt-6 space-y-2 text-sm">
          {producto.marca && (
            <div class="flex gap-2"><dt class="text-neutral-400">Marca:</dt><dd class="text-neutral-700">{producto.marca}</dd></div>
          )}
          {producto.estado && (
            <div class="flex gap-2"><dt class="text-neutral-400">Estado:</dt><dd class="text-neutral-700">{producto.estado}</dd></div>
          )}
          {producto.capacidad && (
            <div class="flex gap-2"><dt class="text-neutral-400">Capacidad:</dt><dd class="text-neutral-700">{producto.capacidad}</dd></div>
          )}
          {producto.edadRecomendada && (
            <div class="flex gap-2"><dt class="text-neutral-400">Edad recomendada:</dt><dd class="text-neutral-700">{producto.edadRecomendada}</dd></div>
          )}
          {producto.edicion && (
            <div class="flex gap-2"><dt class="text-neutral-400">Edición:</dt><dd class="text-neutral-700">{producto.edicion}</dd></div>
          )}
        </dl>

        {producto.agotado ? (
          <div class="mt-8 w-full rounded-md bg-neutral-100 border border-neutral-200 px-6 py-3 text-center text-sm font-semibold text-neutral-500 tracking-wide">
            AGOTADO
          </div>
        ) : (
          <a
            href={linkWhatsApp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex w-full items-center justify-center rounded-md bg-neutral-900 px-6 py-3 text-sm font-medium text-white hover:bg-neutral-700 transition-colors"
          >
            Comprar por WhatsApp
          </a>
        )}
      </div>
    </div>
  </main>

  <div id="lightbox" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label="Foto ampliada">
    <div id="lightbox-overlay" class="absolute inset-0 bg-black/90"></div>

    <button
      type="button"
      id="lightbox-cerrar"
      aria-label="Cerrar"
      class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-2xl leading-none"
    >&times;</button>

    <button
      type="button"
      id="lightbox-anterior"
      aria-label="Foto anterior"
      class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-2xl leading-none"
    >&lsaquo;</button>

    <button
      type="button"
      id="lightbox-siguiente"
      aria-label="Foto siguiente"
      class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-2xl leading-none"
    >&rsaquo;</button>

    <div id="lightbox-contenido" class="relative w-full h-full flex items-center justify-center px-4 py-16 pointer-events-none">
      <img id="lightbox-imagen" src="" alt={textoAlt} class="max-w-full max-h-full object-contain pointer-events-auto select-none" />
    </div>
  </div>
</Layout>

<script>
  const imagenPrincipal = document.getElementById('imagen-principal') as HTMLImageElement;
  const miniaturas = document.querySelectorAll<HTMLButtonElement>('.miniatura');
  const galeriaProducto = document.getElementById('galeria-producto') as HTMLElement | null;

  let fotos: string[] = [];
  try {
    fotos = JSON.parse(galeriaProducto?.dataset.fotos || '[]');
  } catch {
    fotos = [];
  }

  let indiceActual = 0;

  miniaturas.forEach((boton, indice) => {
    boton.addEventListener('click', () => {
      const nuevaFoto = boton.dataset.full;
      if (nuevaFoto && imagenPrincipal) {
        imagenPrincipal.src = nuevaFoto;
      }
      abrirLightbox(indice);
    });
  });

  imagenPrincipal?.addEventListener('click', () => {
    abrirLightbox(indiceActual);
  });

  const enlaceVolver = document.getElementById('enlace-volver') as HTMLAnchorElement;
  enlaceVolver?.addEventListener('click', (evento) => {
    const vieneDelMismoSitio = document.referrer && document.referrer.startsWith(window.location.origin);
    const hayHistorialParaRegresar = window.history.length > 1;

    if (vieneDelMismoSitio && hayHistorialParaRegresar) {
      evento.preventDefault();
      window.history.back();
    }
  });

  // Lightbox: click en la imagen principal o en cualquier miniatura la abre;
  // dentro se puede navegar entre todas las fotos del producto sin cerrarla.
  const lightbox = document.getElementById('lightbox');
  const lightboxImagen = document.getElementById('lightbox-imagen') as HTMLImageElement | null;
  const lightboxOverlay = document.getElementById('lightbox-overlay');
  const lightboxCerrar = document.getElementById('lightbox-cerrar');
  const lightboxAnterior = document.getElementById('lightbox-anterior') as HTMLButtonElement | null;
  const lightboxSiguiente = document.getElementById('lightbox-siguiente') as HTMLButtonElement | null;

  function actualizarLightbox() {
    if (!lightboxImagen) return;
    lightboxImagen.src = fotos[indiceActual];

    const hayVarias = fotos.length > 1;
    lightboxAnterior?.classList.toggle('hidden', !hayVarias);
    lightboxSiguiente?.classList.toggle('hidden', !hayVarias);
  }

  function abrirLightbox(indice: number) {
    if (!lightbox || fotos.length === 0) return;
    indiceActual = indice;
    actualizarLightbox();
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function cerrarLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function fotoAnterior() {
    indiceActual = (indiceActual - 1 + fotos.length) % fotos.length;
    actualizarLightbox();
  }

  function fotoSiguiente() {
    indiceActual = (indiceActual + 1) % fotos.length;
    actualizarLightbox();
  }

  lightboxOverlay?.addEventListener('click', cerrarLightbox);
  lightboxCerrar?.addEventListener('click', cerrarLightbox);
  lightboxAnterior?.addEventListener('click', fotoAnterior);
  lightboxSiguiente?.addEventListener('click', fotoSiguiente);

  document.addEventListener('keydown', (evento) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (evento.key === 'Escape') cerrarLightbox();
    if (evento.key === 'ArrowLeft') fotoAnterior();
    if (evento.key === 'ArrowRight') fotoSiguiente();
  });

  let inicioX = 0;
  let inicioY = 0;
  const UMBRAL_SWIPE = 50;

  lightbox?.addEventListener(
    'touchstart',
    (evento) => {
      const toque = evento.touches[0];
      inicioX = toque.clientX;
      inicioY = toque.clientY;
    },
    { passive: true }
  );

  lightbox?.addEventListener(
    'touchend',
    (evento) => {
      const toque = evento.changedTouches[0];
      const deltaX = toque.clientX - inicioX;
      const deltaY = toque.clientY - inicioY;

      if (Math.abs(deltaX) > UMBRAL_SWIPE && Math.abs(deltaX) > Math.abs(deltaY)) {
        if (deltaX > 0) {
          fotoAnterior();
        } else {
          fotoSiguiente();
        }
      }
    },
    { passive: true }
  );
</script>
