---
import { sanityClient, urlFor, obtenerConfiguracionWhatsApp, numeroWhatsAppParaDepartamento, nombreDepartamento } from '../../lib/sanity';
import Layout from '../../layouts/Layout.astro';
import MenuHamburguesa from '../../components/MenuHamburguesa.astro';
import Footer from '../../components/Footer.astro';
import BotonCarrito from '../../components/BotonCarrito.astro';
import PanelCarrito from '../../components/PanelCarrito.astro';

// Todo se trae UNA sola vez en getStaticPaths y se pasa a cada página como props.
// Antes cada ficha hacía 3 consultas a Sanity por su cuenta (producto, WhatsApp y
// departamentos): con 1,000+ productos eran 3,000+ consultas y el build tardaba minutos.
export async function getStaticPaths() {
  const [productos, configWhatsApp, todosDepartamentos] = await Promise.all([
    sanityClient.fetch(`
      *[_type == "producto" && defined(slug.current)]{
        "slug": slug.current,
        _createdAt,
        "categoriaId": categoria._ref,
        titulo,
        precio,
        estado,
        descripcion,
        altTexto,
        imagenPrincipal,
        galeria,
        edicion,
        capacidad,
        marca,
        edadRecomendada,
        palabrasClave,
        mostrarExistencias,
        cantidadDisponible,
        agotado,
        "categoriaTitulo": categoria->titulo,
        "categoriaDepartamento": categoria->departamento
      }
    `),
    obtenerConfiguracionWhatsApp(),
    // El menú hamburguesa lista todos los departamentos, así que hay que traerlos aquí también.
    sanityClient.fetch(`
      array::unique(*[_type == "categoria" && defined(departamento)].departamento)
    `),
  ]);

  // Si dos productos compartieran slug, se queda el primero (igual que antes con [0]).
  const slugsVistos = new Set<string>();
  const productosUnicos = productos.filter((producto: any) => {
    if (slugsVistos.has(producto.slug)) return false;
    slugsVistos.add(producto.slug);
    return true;
  });

  // "También te puede gustar": hasta 4 del mismo subdepartamento (y si no alcanzan,
  // del mismo departamento). Solo disponibles y con foto; primero los que tienen
  // precio y luego los más nuevos. Se calcula aquí, sin consultas extra a Sanity.
  const LIMITE_RELACIONADOS = 4;
  const candidatos = [...productosUnicos]
    .filter((p: any) => !p.agotado && p.imagenPrincipal)
    .sort(
      (a: any, b: any) =>
        Number(b.precio != null) - Number(a.precio != null) ||
        String(b._createdAt || '').localeCompare(String(a._createdAt || ''))
    );

  function relacionadosDe(producto: any) {
    const mismaCategoria = candidatos.filter(
      (p: any) => p.slug !== producto.slug && p.categoriaId && p.categoriaId === producto.categoriaId
    );
    const mismoDepartamento = candidatos.filter(
      (p: any) =>
        p.slug !== producto.slug &&
        p.categoriaId !== producto.categoriaId &&
        p.categoriaDepartamento === producto.categoriaDepartamento
    );
    return [...mismaCategoria, ...mismoDepartamento].slice(0, LIMITE_RELACIONADOS).map((p: any) => ({
      slug: p.slug,
      titulo: p.titulo,
      precio: p.precio,
      altTexto: p.altTexto,
      imagenPrincipal: p.imagenPrincipal,
    }));
  }

  return productosUnicos.map((producto: any) => ({
    params: { slug: producto.slug },
    props: { producto, configWhatsApp, todosDepartamentos, relacionados: relacionadosDe(producto) },
  }));
}

const { slug } = Astro.params;
const { producto, configWhatsApp, todosDepartamentos, relacionados } = Astro.props as any;

const textoAlt = producto.altTexto || producto.titulo;

const TEXTO_ENTREGA = 'Entrega personal en Monterrey, envío disponible a toda la República Mexicana';
const descripcionCompleta = producto.descripcion
  ? `${producto.descripcion}\n\n${TEXTO_ENTREGA}`
  : TEXTO_ENTREGA;

const LIMITE_META = 155;
const descripcionBase = producto.descripcion || TEXTO_ENTREGA;
const descripcionMeta =
  descripcionBase.length > LIMITE_META
    ? `${descripcionBase.slice(0, LIMITE_META - 1).trimEnd()}…`
    : descripcionBase;

const numeroWhatsApp = numeroWhatsAppParaDepartamento(producto.categoriaDepartamento, configWhatsApp);
const nombreDepartamentoTexto = nombreDepartamento(producto.categoriaDepartamento, configWhatsApp);

const linkProducto = `https://hgstoremx.com/productos/${slug}/`;

const linkAvisame = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(
  `Hola, me interesa "${producto.titulo}" que aparece agotado: ${linkProducto} ¿Me avisas cuando te vuelva a llegar?`
)}`;

const linkVolverRespaldo = `/catalogo/${producto.categoriaDepartamento}/`;

const imagenPrincipalUrl = urlFor(producto.imagenPrincipal).width(800).auto('format').url();

const galeria = (producto.galeria || []).map((img: any) => ({
  miniatura: urlFor(img).width(200).auto('format').url(),
  completa: urlFor(img).width(800).auto('format').url(),
}));

const todasLasFotos = [
  { miniatura: urlFor(producto.imagenPrincipal).width(200).auto('format').url(), completa: imagenPrincipalUrl },
  ...galeria,
];

const mostrarBadgeExistencias =
  producto.mostrarExistencias && producto.cantidadDisponible !== undefined && producto.cantidadDisponible !== null;
const pocasPiezas = mostrarBadgeExistencias && producto.cantidadDisponible <= 2;

const disponibilidad = producto.agotado
  ? 'https://schema.org/OutOfStock'
  : producto.cantidadDisponible !== undefined && producto.cantidadDisponible !== null && producto.cantidadDisponible <= 0
    ? 'https://schema.org/OutOfStock'
    : 'https://schema.org/InStock';

const datosEstructurados = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: producto.titulo,
  image: [imagenPrincipalUrl, ...galeria.map((g: { completa: string }) => g.completa)],
  description: descripcionMeta,
  ...(producto.marca ? { brand: { '@type': 'Brand', name: producto.marca } } : {}),
  ...(producto.precio != null
    ? {
        offers: {
          '@type': 'Offer',
          url: linkProducto,
          priceCurrency: 'MXN',
          price: producto.precio,
          availability: disponibilidad,
        },
      }
    : {}),
};

const datosBreadcrumb = {
  '@context': 'https://schema.org/',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://hgstoremx.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: nombreDepartamentoTexto,
      item: `https://hgstoremx.com/catalogo/${producto.categoriaDepartamento}/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: producto.titulo,
      item: linkProducto,
    },
  ],
};
---
<Layout
  titulo={`${producto.titulo} - HG Store MX`}
  descripcion={descripcionMeta}
  imagen={imagenPrincipalUrl}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
    <script type="application/ld+json" set:html={JSON.stringify(datosBreadcrumb)} />
  </Fragment>

  <MenuHamburguesa departamentos={todosDepartamentos} configWhatsApp={configWhatsApp}>
    <BotonCarrito slot="carrito" />
  </MenuHamburguesa>
  <PanelCarrito numeroDefault={configWhatsApp.numeroDefault} />

  <nav aria-label="Ruta de navegación" class="flex items-center gap-1.5 px-6 py-2 max-w-3xl mx-auto text-sm border-b border-neutral-100 overflow-hidden">
    <a href="/" class="shrink-0 text-neutral-500 hover:text-neutral-900">Inicio</a>
    <span class="shrink-0 text-neutral-300" aria-hidden="true">&rsaquo;</span>
    <a id="enlace-volver" href={linkVolverRespaldo} data-departamento={nombreDepartamentoTexto} class="shrink-0 text-neutral-500 hover:text-neutral-900">
      {nombreDepartamentoTexto}
    </a>
    <span class="shrink-0 text-neutral-300" aria-hidden="true">&rsaquo;</span>
    <span class="font-medium text-neutral-900 truncate">{producto.titulo}</span>
  </nav>

  <main class="px-6 pt-6 pb-12 max-w-3xl mx-auto" data-tarjeta-producto>
    <div class="grid md:grid-cols-2 gap-10">
      <div id="galeria-producto" data-fotos={JSON.stringify(todasLasFotos.map((f) => f.completa))}>
        <div class="aspect-square w-full overflow-hidden rounded-xl bg-neutral-50 border border-neutral-100">
          <img
            id="imagen-principal"
            src={imagenPrincipalUrl}
            alt={textoAlt}
            class={`w-full h-full object-contain cursor-zoom-in ${producto.agotado ? 'opacity-50 grayscale' : ''}`}
          />
        </div>

        {todasLasFotos.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-2">
            {todasLasFotos.map((foto) => (
              <button
                type="button"
                class="miniatura aspect-square overflow-hidden rounded-lg bg-neutral-50 border border-neutral-100 hover:border-neutral-400 transition-colors"
                data-full={foto.completa}
              >
                <img src={foto.miniatura} alt={textoAlt} class="w-full h-full object-contain" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div>
        {producto.categoriaTitulo && (
          <p class="text-xs uppercase tracking-wide text-neutral-400">{producto.categoriaTitulo}</p>
        )}
        <h1 class="mt-1 text-2xl font-semibold text-neutral-900">{producto.titulo}</h1>
        {producto.precio != null ? (
          <p class="mt-3 text-2xl font-semibold text-neutral-900">${producto.precio} MXN</p>
        ) : (
          <p class="mt-3 text-2xl font-semibold text-neutral-500">Consultar precio</p>
        )}

        {producto.agotado ? (
          <p class="mt-2 inline-block text-xs font-medium px-2 py-1 rounded-full bg-neutral-100 text-neutral-600">
            Agotado
          </p>
        ) : mostrarBadgeExistencias && (
          <p class={`mt-2 inline-block text-xs font-medium px-2 py-1 rounded-full ${pocasPiezas ? 'bg-amber-50 text-amber-700' : 'bg-green-50 text-green-700'}`}>
            {pocasPiezas ? '¡Pocas piezas!' : 'Disponible'}
          </p>
        )}

        <p class="mt-4 text-neutral-600 leading-relaxed whitespace-pre-line">{descripcionCompleta}</p>

        <dl class="mt-6 space-y-2 text-sm">
          {producto.marca && (
            <div class="flex gap-2"><dt class="text-neutral-400">Marca:</dt><dd class="text-neutral-700">{producto.marca}</dd></div>
          )}
          {producto.estado && (
            <div class="flex gap-2"><dt class="text-neutral-400">Estado:</dt><dd class="text-neutral-700">{producto.estado}</dd></div>
          )}
          {producto.capacidad && (
            <div class="flex gap-2"><dt class="text-neutral-400">Capacidad:</dt><dd class="text-neutral-700">{producto.capacidad}</dd></div>
          )}
          {producto.edadRecomendada && (
            <div class="flex gap-2"><dt class="text-neutral-400">Edad recomendada:</dt><dd class="text-neutral-700">{producto.edadRecomendada}</dd></div>
          )}
          {producto.edicion && (
            <div class="flex gap-2"><dt class="text-neutral-400">Edición:</dt><dd class="text-neutral-700">{producto.edicion}</dd></div>
          )}
        </dl>

        <button
          id="boton-compartir"
          type="button"
          data-titulo={producto.titulo}
          data-url={linkProducto}
          class="mt-8 w-full inline-flex items-center justify-center gap-2 rounded-md border border-neutral-200 px-6 py-3 text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
          Compartir
        </button>

        {producto.agotado ? (
          <div class="mt-3 w-full rounded-md bg-neutral-100 border border-neutral-200 px-6 py-3 text-center text-sm font-semibold text-neutral-500 tracking-wide">
            AGOTADO
          </div>
          <a
            id="boton-avisame"
            href={linkAvisame}
            target="_blank"
            rel="noopener"
            data-slug={slug}
            data-titulo={producto.titulo}
            class="mt-3 w-full inline-flex items-center justify-center rounded-md border border-neutral-900 bg-white px-6 py-3 text-sm font-medium text-neutral-900 hover:bg-neutral-100 transition-colors"
          >
            Avísame por WhatsApp cuando vuelva a llegar
          </a>
        ) : (
          <>
            <div class="mt-3">
              <button
                type="button"
                class="btn-agregar-carrito w-full inline-flex items-center justify-center rounded-md border border-neutral-900 bg-neutral-900 px-6 py-3 text-sm font-medium text-white hover:bg-neutral-700 transition-colors"
                data-slug={slug}
                data-titulo={producto.titulo}
                data-numero={numeroWhatsApp}
              >
                Agregar al carrito
              </button>
            </div>

            <p class="mt-4 text-base leading-relaxed text-neutral-600 text-center">
              Para pedir este producto, agrégalo al carrito y envía tu lista por WhatsApp. El pago y la entrega se acuerdan ahí; en ningún momento se te solicitará ningún pago en este sitio.
            </p>
          </>
        )}
      </div>
    </div>

    {relacionados.length > 0 && (
      <section class="mt-16" aria-labelledby="titulo-relacionados">
        <h2 id="titulo-relacionados" class="text-lg font-semibold text-neutral-900 mb-4">También te puede gustar</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-8">
          {relacionados.map((r: any) => (
            <a href={`/productos/${r.slug}/`} class="block group">
              <div class="aspect-square w-full overflow-hidden rounded-lg bg-neutral-50 border border-neutral-100">
                <img
                  src={urlFor(r.imagenPrincipal).width(400).auto('format').url()}
                  alt={r.altTexto || r.titulo}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-contain transition-transform group-hover:scale-105"
                />
              </div>
              <h3 class="mt-3 text-sm font-medium text-neutral-900 line-clamp-2">{r.titulo}</h3>
              {r.precio != null ? (
                <p class="mt-1 text-base font-semibold text-neutral-900">${r.precio} MXN</p>
              ) : (
                <p class="mt-1 text-base font-semibold text-neutral-500">Consultar precio</p>
              )}
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <div id="lightbox" class="hidden fixed inset-0 z-50" role="dialog" aria-modal="true" aria-label="Foto ampliada">
    <div id="lightbox-overlay" class="absolute inset-0 bg-black/90"></div>

    <button
      type="button"
      id="lightbox-cerrar"
      aria-label="Cerrar"
      class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-2xl leading-none"
    >&times;</button>

    <button
      type="button"
      id="lightbox-anterior"
      aria-label="Foto anterior"
      class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-2xl leading-none"
    >&lsaquo;</button>

    <button
      type="button"
      id="lightbox-siguiente"
      aria-label="Foto siguiente"
      class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-2xl leading-none"
    >&rsaquo;</button>

    <div id="lightbox-contenido" class="relative w-full h-full flex items-center justify-center px-4 py-16 pointer-events-none">
      <img id="lightbox-imagen" src="" alt={textoAlt} class="max-w-full max-h-full object-contain pointer-events-auto select-none" />
    </div>
  </div>

  <Footer departamentos={todosDepartamentos} configWhatsApp={configWhatsApp} />
</Layout>

<script>
  import {
    estaEnCarrito,
    agregarAlCarrito,
    quitarDelCarrito,
  } from '../../lib/carrito';

  // Misma lógica que ProductCard.astro, replicada aquí porque el script de ese
  // componente no se carga en esta página (no se usa ProductCard en la ficha).
  // Dos aspectos completos del botón. Se cambian juntos (fondo, texto y hover) para que
  // el texto nunca quede del mismo color que el fondo, ni siquiera al pasar el cursor.
  const CLASES_AGREGAR = ['bg-neutral-900', 'text-white', 'hover:bg-neutral-700'];
  const CLASES_EN_CARRITO = ['bg-white', 'text-neutral-900', 'hover:bg-neutral-100'];

  function actualizarBotonesCarrito() {
    const contenedor = document.querySelector<HTMLElement>('[data-tarjeta-producto]');
    if (!contenedor) return;

    const btnCarrito = contenedor.querySelector<HTMLButtonElement>('.btn-agregar-carrito');
    const slugProducto = btnCarrito?.dataset.slug;
    if (!btnCarrito || !slugProducto) return;

    const enCarrito = estaEnCarrito(slugProducto);
    btnCarrito.textContent = enCarrito ? 'Quitar del carrito' : 'Agregar al carrito';
    btnCarrito.classList.remove(...(enCarrito ? CLASES_AGREGAR : CLASES_EN_CARRITO));
    btnCarrito.classList.add(...(enCarrito ? CLASES_EN_CARRITO : CLASES_AGREGAR));
  }

  function iniciarCarrito() {
    actualizarBotonesCarrito();

    const btn = document.querySelector<HTMLButtonElement>('.btn-agregar-carrito');
    btn?.addEventListener('click', () => {
      const slugProducto = btn.dataset.slug!;
      const tituloProducto = btn.dataset.titulo!;
      const numeroProducto = btn.dataset.numero!;

      if (estaEnCarrito(slugProducto)) {
        quitarDelCarrito(slugProducto);
      } else {
        agregarAlCarrito({ slug: slugProducto, titulo: tituloProducto, numeroWhatsApp: numeroProducto });
      }

      actualizarBotonesCarrito();
      document.dispatchEvent(new CustomEvent('carrito-actualizado'));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarCarrito);
  } else {
    iniciarCarrito();
  }

  document.addEventListener('carrito-actualizado', actualizarBotonesCarrito);
</script>

<script>
  import { registrarEvento } from '../../lib/metricas';

  // "Compartir": en celular abre el menú nativo (WhatsApp, Messenger, etc.); si el
  // navegador no lo soporta, abre WhatsApp con el link ya escrito.
  const botonCompartir = document.getElementById('boton-compartir') as HTMLButtonElement | null;
  botonCompartir?.addEventListener('click', async () => {
    const titulo = botonCompartir.dataset.titulo || '';
    const url = botonCompartir.dataset.url || window.location.href;
    const texto = `Mira este producto en HG Store MX: ${titulo}`;
    if (navigator.share) {
      try {
        await navigator.share({ title: titulo, text: texto, url });
      } catch {
        // El cliente canceló el menú de compartir: no hacer nada.
      }
      return;
    }
    window.open(`https://wa.me/?text=${encodeURIComponent(`${texto} ${url}`)}`, '_blank', 'noopener');
  });

  // "Avísame cuando vuelva a llegar": se cuenta (anónimo) para saber qué volver a surtir.
  const botonAvisame = document.getElementById('boton-avisame') as HTMLAnchorElement | null;
  botonAvisame?.addEventListener('click', () => {
    registrarEvento('avisame', [{ slug: botonAvisame.dataset.slug || '', titulo: botonAvisame.dataset.titulo || '' }]);
  });
</script>

<script>
  const imagenPrincipal = document.getElementById('imagen-principal') as HTMLImageElement;
  const miniaturas = document.querySelectorAll<HTMLButtonElement>('.miniatura');
  const galeriaProducto = document.getElementById('galeria-producto') as HTMLElement | null;

  let fotos: string[] = [];
  try {
    fotos = JSON.parse(galeriaProducto?.dataset.fotos || '[]');
  } catch {
    fotos = [];
  }

  let indiceActual = 0;

  miniaturas.forEach((boton, indice) => {
    boton.addEventListener('click', () => {
      const nuevaFoto = boton.dataset.full;
      if (nuevaFoto && imagenPrincipal) {
        imagenPrincipal.src = nuevaFoto;
      }
      abrirLightbox(indice);
    });
  });

  imagenPrincipal?.addEventListener('click', () => {
    abrirLightbox(indiceActual);
  });

  function sinBarraFinal(pathname: string): string {
    return pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
  }

  const enlaceVolver = document.getElementById('enlace-volver') as HTMLAnchorElement;
  enlaceVolver?.addEventListener('click', (evento) => {
    // "Volver" siempre debe caer en la categoría de ESTE producto (el href ya apunta ahí).
    // Solo usamos history.back() cuando el referrer es exactamente esa página de categoría,
    // para recuperar scroll y estado (ej. "ver más" expandido) tal como se dejó — si se llegó
    // desde otro lado (inicio, otro producto, WhatsApp, buscador externo), navegamos normal.
    // Comparamos sin la barra final porque en producción las rutas se sirven con "/" al final.
    let vieneDeEstaCategoria = false;
    if (document.referrer) {
      try {
        vieneDeEstaCategoria = sinBarraFinal(new URL(document.referrer).pathname) === sinBarraFinal(enlaceVolver.pathname);
      } catch {
        vieneDeEstaCategoria = false;
      }
    }
    const hayHistorialParaRegresar = window.history.length > 1;

    if (vieneDeEstaCategoria && hayHistorialParaRegresar) {
      evento.preventDefault();
      window.history.back();
    }
  });

  // Lightbox: click en la imagen principal o en cualquier miniatura la abre;
  // dentro se puede navegar entre todas las fotos del producto sin cerrarla.
  const lightbox = document.getElementById('lightbox');
  const lightboxImagen = document.getElementById('lightbox-imagen') as HTMLImageElement | null;
  const lightboxOverlay = document.getElementById('lightbox-overlay');
  const lightboxCerrar = document.getElementById('lightbox-cerrar');
  const lightboxAnterior = document.getElementById('lightbox-anterior') as HTMLButtonElement | null;
  const lightboxSiguiente = document.getElementById('lightbox-siguiente') as HTMLButtonElement | null;

  function actualizarLightbox() {
    if (!lightboxImagen) return;
    lightboxImagen.src = fotos[indiceActual];

    const hayVarias = fotos.length > 1;
    lightboxAnterior?.classList.toggle('hidden', !hayVarias);
    lightboxSiguiente?.classList.toggle('hidden', !hayVarias);
  }

  function abrirLightbox(indice: number) {
    if (!lightbox || fotos.length === 0) return;
    indiceActual = indice;
    actualizarLightbox();
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function cerrarLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function fotoAnterior() {
    indiceActual = (indiceActual - 1 + fotos.length) % fotos.length;
    actualizarLightbox();
  }

  function fotoSiguiente() {
    indiceActual = (indiceActual + 1) % fotos.length;
    actualizarLightbox();
  }

  lightboxOverlay?.addEventListener('click', cerrarLightbox);
  lightboxCerrar?.addEventListener('click', cerrarLightbox);
  lightboxAnterior?.addEventListener('click', fotoAnterior);
  lightboxSiguiente?.addEventListener('click', fotoSiguiente);

  document.addEventListener('keydown', (evento) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (evento.key === 'Escape') cerrarLightbox();
    if (evento.key === 'ArrowLeft') fotoAnterior();
    if (evento.key === 'ArrowRight') fotoSiguiente();
  });

  let inicioX = 0;
  let inicioY = 0;
  const UMBRAL_SWIPE = 50;

  lightbox?.addEventListener(
    'touchstart',
    (evento) => {
      const toque = evento.touches[0];
      inicioX = toque.clientX;
      inicioY = toque.clientY;
    },
    { passive: true }
  );

  lightbox?.addEventListener(
    'touchend',
    (evento) => {
      const toque = evento.changedTouches[0];
      const deltaX = toque.clientX - inicioX;
      const deltaY = toque.clientY - inicioY;

      if (Math.abs(deltaX) > UMBRAL_SWIPE && Math.abs(deltaX) > Math.abs(deltaY)) {
        if (deltaX > 0) {
          fotoAnterior();
        } else {
          fotoSiguiente();
        }
      }
    },
    { passive: true }
  );
</script>
