---
import { sanityClient, urlFor, nombreDepartamento, obtenerConfiguracionWhatsApp, numeroWhatsAppParaDepartamento } from '../lib/sanity';
import Layout from '../layouts/Layout.astro';
import MenuHamburguesa from '../components/MenuHamburguesa.astro';
import BotonCarrito from '../components/BotonCarrito.astro';
import PanelCarrito from '../components/PanelCarrito.astro';
import ProductCard from '../components/ProductCard.astro';

const categorias = await sanityClient.fetch(`
  *[_type == "categoria" && defined(departamento)]{
    titulo,
    departamento
  }
`);

const productos = await sanityClient.fetch(`
  *[_type == "producto" && defined(categoria)]{
    "slug": slug.current,
    titulo,
    precio,
    descripcion,
    altTexto,
    imagenPrincipal,
    edicion,
    palabrasClave,
    agotado,
    "categoriaDepartamento": categoria->departamento
  }
`);

const configWhatsApp = await obtenerConfiguracionWhatsApp();

const departamentos = Array.from(new Set(categorias.map((c: any) => c.departamento))) as string[];

// Mosaico de fotos de producto por departamento: la tarjeta del inicio ya no usa una sola
// imagen fija de la categoría, sino varias fotos reales elegidas al azar que además rotan
// en el navegador (ver el <script> de "Mosaico de departamentos" más abajo).
const TAMANO_MOSAICO = 4;
const TAMANO_POOL_ROTACION = 10;

function elegirAlAzar<T>(items: T[], cantidad: number): T[] {
  const copia = [...items];
  for (let i = copia.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copia[i], copia[j]] = [copia[j], copia[i]];
  }
  return copia.slice(0, cantidad);
}

function claseCasilla(indice: number, total: number): string {
  if (total === 1) return 'col-span-2 row-span-2';
  if (total === 2) return 'row-span-2';
  if (total === 3 && indice === 0) return 'col-span-2';
  return '';
}

const infoPorDepartamento = departamentos.map((depto) => {
  const productosDelDepto = productos.filter((p: any) => p.categoriaDepartamento === depto);
  const productosConFoto = productosDelDepto.filter((p: any) => p.imagenPrincipal);
  const fotosParaRotar = elegirAlAzar(productosConFoto, TAMANO_POOL_ROTACION).map((p: any) => ({
    slug: p.slug,
    // 200x200 alcanza y sobra para el tamaño real en pantalla de cada casilla del mosaico
    // (~80x60px en móvil, ~185x139px en desktop); .auto('format') deja que Sanity sirva
    // WebP/AVIF según lo que soporte el navegador en vez del JPEG/PNG original.
    url: urlFor(p.imagenPrincipal).width(200).height(200).fit('crop').auto('format').url(),
  }));
  return {
    depto,
    mosaico: fotosParaRotar.slice(0, TAMANO_MOSAICO),
    poolRotacion: fotosParaRotar,
    totalProductos: productosDelDepto.length,
  };
});

const datosOrganizacion = {
  '@context': 'https://schema.org/',
  '@type': 'Organization',
  name: 'HG Shop MX',
  url: 'https://hgstoremx.com/',
};
---
<Layout titulo="HG Shop MX - Catálogo">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(datosOrganizacion)} />
  </Fragment>

  <MenuHamburguesa departamentos={departamentos} configWhatsApp={configWhatsApp}>
    <BotonCarrito slot="carrito" />
  </MenuHamburguesa>
  <PanelCarrito numeroDefault={configWhatsApp.numeroDefault} />

  <section class="px-6 pt-16 pb-4 text-center max-w-2xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-neutral-900">
      Catálogo HG Shop
    </h1>
    <p class="mt-3 text-neutral-500">
      Busca un producto o elige un departamento
    </p>
  </section>

  <div class="sticky z-10 bg-white border-b border-neutral-100 px-6 py-3" style="top: var(--alto-header, 68px);">
    <div class="max-w-2xl mx-auto">
      <input
        type="text"
        id="buscador"
        placeholder="Buscar producto, ej. biberón, Barbie, spa..."
        class="w-full rounded-full border border-neutral-200 px-6 py-3 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-900"
      />
    </div>
  </div>

  <main class="px-6 pt-8 pb-20 max-w-5xl mx-auto">
    <div id="tarjetas-departamentos" class="max-w-3xl mx-auto grid grid-cols-2 gap-4 sm:gap-6">
      {infoPorDepartamento.map(({ depto, mosaico, poolRotacion, totalProductos }, indiceDepartamento) => (
        <div>
          <div
            class="mosaico-departamento aspect-[4/3] overflow-hidden rounded-2xl bg-neutral-100 border border-neutral-100 grid grid-cols-2 grid-rows-2 gap-0.5"
            data-pool={JSON.stringify(poolRotacion)}
          >
            {mosaico.map((foto, indice) => (
              <a
                href={`/productos/${foto.slug}/`}
                data-slug={foto.slug}
                class={`mosaico-casilla group relative block overflow-hidden bg-neutral-200 ${claseCasilla(indice, mosaico.length)}`}
              >
                <img
                  class="mosaico-capa-fondo absolute inset-0 w-full h-full object-cover transition duration-300 group-hover:scale-105"
                  src={foto.url}
                  alt={nombreDepartamento(depto, configWhatsApp)}
                  loading={indiceDepartamento === 0 && indice === 0 ? 'eager' : 'lazy'}
                  fetchpriority={indiceDepartamento === 0 && indice === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
                <img
                  class="mosaico-capa-frente absolute inset-0 w-full h-full object-cover opacity-0 transition duration-[400ms] ease-in-out group-hover:scale-105"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              </a>
            ))}
          </div>
          <a href={`/catalogo/${depto}/`} class="mt-3 block text-center">
            <h2 class="text-neutral-900 text-base sm:text-xl font-semibold">{nombreDepartamento(depto, configWhatsApp)}</h2>
            <p class="text-neutral-500 text-xs sm:text-sm mt-1">{totalProductos} producto{totalProductos !== 1 ? 's' : ''}</p>
          </a>
        </div>
      ))}
    </div>

    <div id="resultados-busqueda" class="hidden">
      <p id="contador-resultados" class="text-sm text-neutral-500 mb-6"></p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-8">
        {productos.map((producto: any) => (
          <div
            class="producto-item"
            data-buscable={`${producto.titulo} ${(producto.palabrasClave || []).join(' ')}`.toLowerCase()}
          >
            <ProductCard
              slug={producto.slug}
              titulo={producto.titulo}
              precio={producto.precio}
              imagenPrincipal={producto.imagenPrincipal}
              descripcion={producto.descripcion}
              altTexto={producto.altTexto}
              edicion={producto.edicion}
              numeroWhatsApp={numeroWhatsAppParaDepartamento(producto.categoriaDepartamento, configWhatsApp)}
              agotado={producto.agotado}
            />
          </div>
        ))}
      </div>
      <p id="sin-resultados" class="hidden text-center text-neutral-400 py-12">
        No se encontraron productos con ese término.
      </p>
    </div>
  </main>
</Layout>

<script>
  const input = document.getElementById('buscador') as HTMLInputElement;
  const tarjetasDepartamentos = document.getElementById('tarjetas-departamentos');
  const resultadosBusqueda = document.getElementById('resultados-busqueda');
  const contadorResultados = document.getElementById('contador-resultados');
  const sinResultados = document.getElementById('sin-resultados');

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    const hayBusqueda = query !== '';

    if (tarjetasDepartamentos) {
      tarjetasDepartamentos.style.display = hayBusqueda ? 'none' : '';
    }
    if (resultadosBusqueda) {
      resultadosBusqueda.classList.toggle('hidden', !hayBusqueda);
    }

    if (!hayBusqueda) return;

    let visibles = 0;
    const items = document.querySelectorAll<HTMLElement>('.producto-item');
    items.forEach((item) => {
      const texto = item.dataset.buscable || '';
      const coincide = texto.includes(query);
      item.style.display = coincide ? '' : 'none';
      if (coincide) visibles++;
    });

    if (contadorResultados) {
      contadorResultados.textContent = `${visibles} resultado${visibles !== 1 ? 's' : ''} para "${query}"`;
    }
    if (sinResultados) {
      sinResultados.classList.toggle('hidden', visibles > 0);
    }
  });
</script>

<script>
  // Mosaico de departamentos: cada tarjeta trae un "pool" de fotos de producto en
  // data-pool; cada pocos segundos se elige una casilla al azar y se le hace fade
  // a otra foto distinta del mismo departamento, sin recargar la página.
  const INTERVALO_BASE_MS = 3500;
  const VARIACION_MS = 2000;
  const DURACION_FADE_MS = 400;

  interface FotoMosaico {
    slug: string;
    url: string;
  }

  document.querySelectorAll<HTMLElement>('.mosaico-departamento').forEach((mosaico) => {
    let pool: FotoMosaico[] = [];
    try {
      pool = JSON.parse(mosaico.dataset.pool || '[]');
    } catch {
      pool = [];
    }

    const casillas = Array.from(mosaico.querySelectorAll<HTMLAnchorElement>('.mosaico-casilla'));
    if (casillas.length === 0) return;

    // Si el pool no trae más fotos que las casillas visibles, ya se están mostrando
    // todos los productos disponibles de este departamento: no hay a qué rotar sin repetir.
    if (pool.length <= casillas.length) return;

    function rotarUnaFoto() {
      const slugsEnPantalla = new Set(casillas.map((casilla) => casilla.dataset.slug));
      const candidatas = pool.filter((foto) => !slugsEnPantalla.has(foto.slug));
      if (candidatas.length === 0) return;

      const casilla = casillas[Math.floor(Math.random() * casillas.length)];
      const capaFondo = casilla.querySelector<HTMLImageElement>('.mosaico-capa-fondo');
      const capaFrente = casilla.querySelector<HTMLImageElement>('.mosaico-capa-frente');
      if (!capaFondo || !capaFrente) return;

      const nuevaFoto = candidatas[Math.floor(Math.random() * candidatas.length)];

      // Crossfade real: la capa de atrás sigue mostrando la foto vieja a opacidad 1
      // mientras la de enfrente (precargada, invisible) se va apareciendo encima —
      // nunca hay un instante en el que ambas capas estén en opacidad 0.
      capaFrente.onload = () => {
        capaFrente.classList.remove('opacity-0');
        capaFrente.classList.add('opacity-100');

        window.setTimeout(() => {
          capaFondo.src = nuevaFoto.url;
          casilla.href = `/productos/${nuevaFoto.slug}/`;
          casilla.dataset.slug = nuevaFoto.slug;

          // La capa de atrás ya tiene la foto nueva: apagar la de enfrente sin
          // transición no se nota (ambas capas coinciden), y queda lista para
          // la siguiente rotación.
          capaFrente.style.transition = 'none';
          capaFrente.classList.remove('opacity-100');
          capaFrente.classList.add('opacity-0');
          void capaFrente.offsetWidth;
          capaFrente.style.transition = '';
        }, DURACION_FADE_MS);
      };
      capaFrente.src = nuevaFoto.url;
    }

    const demora = INTERVALO_BASE_MS + Math.random() * VARIACION_MS;
    window.setInterval(rotarUnaFoto, demora);
  });
</script>
