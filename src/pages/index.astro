---
import { sanityClient, urlFor, nombreDepartamento, obtenerConfiguracionWhatsApp, numeroWhatsAppParaDepartamento } from '../lib/sanity';
import Layout from '../layouts/Layout.astro';
import MenuHamburguesa from '../components/MenuHamburguesa.astro';
import Footer from '../components/Footer.astro';
import BotonCarrito from '../components/BotonCarrito.astro';
import PanelCarrito from '../components/PanelCarrito.astro';
import ProductCard from '../components/ProductCard.astro';

const categorias = await sanityClient.fetch(`
  *[_type == "categoria" && defined(departamento)]{
    titulo,
    departamento
  }
`);

const productos = await sanityClient.fetch(`
  *[_type == "producto" && defined(categoria)]{
    "slug": slug.current,
    titulo,
    precio,
    descripcion,
    altTexto,
    imagenPrincipal,
    edicion,
    palabrasClave,
    agotado,
    "categoriaDepartamento": categoria->departamento
  }
`);

const configWhatsApp = await obtenerConfiguracionWhatsApp();

const departamentos = Array.from(new Set(categorias.map((c: any) => c.departamento))) as string[];

// Foto de producto por departamento: la tarjeta del inicio muestra una sola foto real
// del departamento, elegida al azar, que además rota en el navegador (ver el <script>
// de "Rotación de fotos de departamento" más abajo). Toda la tarjeta es un único link
// al catálogo del departamento.
const TAMANO_POOL_ROTACION = 10;

function elegirAlAzar<T>(items: T[], cantidad: number): T[] {
  const copia = [...items];
  for (let i = copia.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copia[i], copia[j]] = [copia[j], copia[i]];
  }
  return copia.slice(0, cantidad);
}

const infoPorDepartamento = departamentos.map((depto) => {
  const productosDelDepto = productos.filter((p: any) => p.categoriaDepartamento === depto);
  const productosConFoto = productosDelDepto.filter((p: any) => p.imagenPrincipal);
  const fotosParaRotar = elegirAlAzar(productosConFoto, TAMANO_POOL_ROTACION).map((p: any) => ({
    slug: p.slug,
    // 400x300 para la imagen única grande de la tarjeta (antes eran 4 miniaturas de 200x200);
    // .auto('format') deja que Sanity sirva WebP/AVIF según lo que soporte el navegador.
    url: urlFor(p.imagenPrincipal).width(400).height(300).fit('crop').auto('format').url(),
  }));
  return {
    depto,
    fotoInicial: fotosParaRotar[0] || null,
    poolRotacion: fotosParaRotar,
    totalProductos: productosDelDepto.length,
  };
});

const datosOrganizacion = {
  '@context': 'https://schema.org/',
  '@type': 'Organization',
  name: 'HG Store MX',
  url: 'https://hgstoremx.com/',
};

// Meta descripción del inicio: los departamentos con más productos, en el mismo
// estilo de redacción que ya usa generarDescripcionDepartamento() en [departamento].astro.
function listarConMas(nombres: string[], hayMas: boolean): string {
  if (nombres.length === 1) return nombres[0];
  const todosMenosUltimo = nombres.slice(0, -1).join(', ');
  const ultimo = nombres[nombres.length - 1];
  return hayMas ? `${todosMenosUltimo}, ${ultimo} y más` : `${todosMenosUltimo} y ${ultimo}`;
}

const LIMITE_DEPARTAMENTOS_DESCRIPCION = 4;
const departamentosOrdenados = [...infoPorDepartamento].sort(
  (a, b) => b.totalProductos - a.totalProductos
);
const nombresDestacados = departamentosOrdenados
  .slice(0, LIMITE_DEPARTAMENTOS_DESCRIPCION)
  .map((d) => nombreDepartamento(d.depto, configWhatsApp));
const hayMasDepartamentos = departamentosOrdenados.length > LIMITE_DEPARTAMENTOS_DESCRIPCION;

const descripcionInicio = nombresDestacados.length > 0
  ? `Encuentra ${listarConMas(nombresDestacados, hayMasDepartamentos)} — catálogo completo de HG Store MX en Monterrey.`
  : 'Catálogo completo de HG Store MX en Monterrey.';

// Imagen destacada para og:image: una foto real del departamento con más productos.
const productoDestacadoInicio = productos.find(
  (p: any) => p.categoriaDepartamento === departamentosOrdenados[0]?.depto && p.imagenPrincipal
);
const imagenInicio = productoDestacadoInicio
  ? urlFor(productoDestacadoInicio.imagenPrincipal).width(1200).height(630).fit('crop').auto('format').url()
  : undefined;
---
<Layout titulo="HG Store MX - Catálogo" descripcion={descripcionInicio} imagen={imagenInicio}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(datosOrganizacion)} />
  </Fragment>

  <MenuHamburguesa departamentos={departamentos} configWhatsApp={configWhatsApp}>
    <BotonCarrito slot="carrito" />
  </MenuHamburguesa>
  <PanelCarrito numeroDefault={configWhatsApp.numeroDefault} />

  <section class="px-6 pt-16 pb-4 text-center max-w-2xl mx-auto">
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-neutral-900">
      Catálogo HG Store MX
    </h1>
    <p class="mt-3 text-neutral-500">
      Busca un producto o elige un departamento
    </p>
  </section>

  <div class="sticky z-10 bg-white border-b border-neutral-100 px-6 py-3" style="top: var(--alto-header, 68px);">
    <div class="max-w-2xl mx-auto">
      <input
        type="text"
        id="buscador"
        placeholder="Buscar producto, ej. biberón, Barbie, spa..."
        class="w-full rounded-full border border-neutral-200 px-6 py-3 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-900"
      />
    </div>
  </div>

  <p class="px-6 pt-5 max-w-2xl mx-auto text-center text-base leading-relaxed text-neutral-600">
    Para pedir cualquier producto, agrégalo al carrito y envía tu lista por WhatsApp. El pago y la entrega se acuerdan ahí; en ningún momento se te solicitará ningún pago en este sitio.
  </p>

  <main class="px-6 pt-8 pb-20 max-w-5xl mx-auto">
    <div id="tarjetas-departamentos" class="max-w-3xl mx-auto grid grid-cols-2 gap-4 sm:gap-6">
      {infoPorDepartamento.map(({ depto, fotoInicial, poolRotacion, totalProductos }, indiceDepartamento) => (
        <a href={`/catalogo/${depto}/`} class="group block">
          <div
            class="foto-departamento relative aspect-[4/3] overflow-hidden rounded-2xl bg-neutral-100 border border-neutral-100"
            data-pool={JSON.stringify(poolRotacion)}
          >
            <img
              class="capa-fondo absolute inset-0 w-full h-full object-cover transition duration-300 group-hover:scale-105"
              src={fotoInicial?.url}
              alt={nombreDepartamento(depto, configWhatsApp)}
              loading={indiceDepartamento === 0 ? 'eager' : 'lazy'}
              fetchpriority={indiceDepartamento === 0 ? 'high' : 'auto'}
              decoding="async"
            />
            <img
              class="capa-frente absolute inset-0 w-full h-full object-cover opacity-0 transition duration-[400ms] ease-in-out group-hover:scale-105"
              alt=""
              aria-hidden="true"
              loading="lazy"
            />
          </div>
          <div class="mt-3 text-center">
            <h2 class="text-neutral-900 text-base sm:text-xl font-semibold">{nombreDepartamento(depto, configWhatsApp)}</h2>
            <p class="text-neutral-500 text-xs sm:text-sm mt-1">{totalProductos} producto{totalProductos !== 1 ? 's' : ''}</p>
          </div>
        </a>
      ))}
    </div>

    <div id="resultados-busqueda" class="hidden">
      <p id="contador-resultados" class="text-sm text-neutral-500 mb-6"></p>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-8">
        {productos.map((producto: any) => (
          <div
            class="producto-item"
            data-buscable={`${producto.titulo} ${(producto.palabrasClave || []).join(' ')}`.toLowerCase()}
          >
            <ProductCard
              slug={producto.slug}
              titulo={producto.titulo}
              precio={producto.precio}
              imagenPrincipal={producto.imagenPrincipal}
              descripcion={producto.descripcion}
              altTexto={producto.altTexto}
              edicion={producto.edicion}
              numeroWhatsApp={numeroWhatsAppParaDepartamento(producto.categoriaDepartamento, configWhatsApp)}
              agotado={producto.agotado}
            />
          </div>
        ))}
      </div>
      <p id="sin-resultados" class="hidden text-center text-neutral-400 py-12">
        No se encontraron productos con ese término.
      </p>
    </div>
  </main>

  <Footer departamentos={departamentos} configWhatsApp={configWhatsApp} />
</Layout>

<script>
  const input = document.getElementById('buscador') as HTMLInputElement;
  const tarjetasDepartamentos = document.getElementById('tarjetas-departamentos');
  const resultadosBusqueda = document.getElementById('resultados-busqueda');
  const contadorResultados = document.getElementById('contador-resultados');
  const sinResultados = document.getElementById('sin-resultados');

  function aplicarBusqueda(query: string, actualizarUrl = true) {
    const hayBusqueda = query !== '';

    if (tarjetasDepartamentos) {
      tarjetasDepartamentos.style.display = hayBusqueda ? 'none' : '';
    }
    if (resultadosBusqueda) {
      resultadosBusqueda.classList.toggle('hidden', !hayBusqueda);
    }

    // Reflejar la búsqueda en la URL sin recargar la página, para que el link de la
    // barra de direcciones se pueda copiar y compartir tal cual. Con búsqueda la ruta
    // es /buscar?q=... (página que entrega la foto correcta a Messenger/WhatsApp y
    // luego manda a quien la abre de vuelta aquí); sin búsqueda, la ruta es /.
    if (actualizarUrl) {
      const url = new URL(window.location.href);
      if (hayBusqueda) {
        url.pathname = '/buscar';
        url.searchParams.set('q', query);
      } else {
        url.pathname = '/';
        url.searchParams.delete('q');
      }
      window.history.replaceState({}, '', url);
    }

    if (!hayBusqueda) return;

    let visibles = 0;
    const items = document.querySelectorAll<HTMLElement>('.producto-item');
    items.forEach((item) => {
      const texto = item.dataset.buscable || '';
      const coincide = texto.includes(query);
      item.style.display = coincide ? '' : 'none';
      if (coincide) visibles++;
    });

    if (contadorResultados) {
      contadorResultados.textContent = `${visibles} resultado${visibles !== 1 ? 's' : ''} para "${query}"`;
    }
    if (sinResultados) {
      sinResultados.classList.toggle('hidden', visibles > 0);
    }
  }

  input?.addEventListener('input', () => {
    aplicarBusqueda(input.value.trim().toLowerCase());
  });

  // Si alguien abre un link con ?q=algo (por ejemplo el que tú compartiste),
  // precargar esa búsqueda automáticamente al entrar a la página. También se
  // actualiza la URL (a /buscar?q=...) para que, si esa persona reenvía el link
  // desde su barra de direcciones, la vista previa lleve la foto de la búsqueda.
  const queryInicial = new URLSearchParams(window.location.search).get('q');
  if (queryInicial && input) {
    input.value = queryInicial;
    aplicarBusqueda(queryInicial.toLowerCase(), true);
  }
</script>

<script>
  // Rotación de fotos de departamento: cada tarjeta trae un "pool" de fotos de producto
  // en data-pool; cada pocos segundos se le hace un crossfade a otra foto distinta del
  // mismo departamento, sin recargar la página. La foto ya no es un link a producto —
  // toda la tarjeta lleva al catálogo del departamento.
  const INTERVALO_BASE_MS = 3500;
  const VARIACION_MS = 2000;
  const DURACION_FADE_MS = 400;

  interface FotoDepartamento {
    slug: string;
    url: string;
  }

  document.querySelectorAll<HTMLElement>('.foto-departamento').forEach((contenedor) => {
    let pool: FotoDepartamento[] = [];
    try {
      pool = JSON.parse(contenedor.dataset.pool || '[]');
    } catch {
      pool = [];
    }

    // Con una sola foto en el pool no hay a qué rotar.
    if (pool.length <= 1) return;

    const capaFondo = contenedor.querySelector<HTMLImageElement>('.capa-fondo');
    const capaFrente = contenedor.querySelector<HTMLImageElement>('.capa-frente');
    if (!capaFondo || !capaFrente) return;

    let indiceActual = 0;

    function rotarFoto() {
      // Avanzar en orden por el pool en vez de al azar: así se ven todas las fotos
      // del departamento sin repetir hasta dar la vuelta completa.
      indiceActual = (indiceActual + 1) % pool.length;
      const nuevaFoto = pool[indiceActual];

      // Crossfade real: la capa de atrás sigue mostrando la foto vieja a opacidad 1
      // mientras la de enfrente (precargada, invisible) se va apareciendo encima —
      // nunca hay un instante en el que ambas capas estén en opacidad 0.
      capaFrente.onload = () => {
        capaFrente.classList.remove('opacity-0');
        capaFrente.classList.add('opacity-100');

        window.setTimeout(() => {
          capaFondo.src = nuevaFoto.url;

          // La capa de atrás ya tiene la foto nueva: apagar la de enfrente sin
          // transición no se nota (ambas capas coinciden), y queda lista para
          // la siguiente rotación.
          capaFrente.style.transition = 'none';
          capaFrente.classList.remove('opacity-100');
          capaFrente.classList.add('opacity-0');
          void capaFrente.offsetWidth;
          capaFrente.style.transition = '';
        }, DURACION_FADE_MS);
      };
      capaFrente.src = nuevaFoto.url;
    }

    const demora = INTERVALO_BASE_MS + Math.random() * VARIACION_MS;
    window.setInterval(rotarFoto, demora);
  });
</script>
