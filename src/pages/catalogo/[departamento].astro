---
import { sanityClient, urlFor, obtenerConfiguracionWhatsApp, numeroWhatsAppParaDepartamento, nombreDepartamento } from '../../lib/sanity';
import Layout from '../../layouts/Layout.astro';
import MenuHamburguesa from '../../components/MenuHamburguesa.astro';
import Footer from '../../components/Footer.astro';
import BotonCarrito from '../../components/BotonCarrito.astro';
import PanelCarrito from '../../components/PanelCarrito.astro';
import ProductCard from '../../components/ProductCard.astro';
import { prepararTexto } from '../../lib/buscador';

export async function getStaticPaths() {
  const departamentos = await sanityClient.fetch(`
    array::unique(*[_type == "categoria" && defined(departamento)].departamento)
  `);

  return departamentos.map((depto: string) => ({
    params: { departamento: depto },
  }));
}

const { departamento } = Astro.params as { departamento: string };

const todosDepartamentos = await sanityClient.fetch(`
  array::unique(*[_type == "categoria" && defined(departamento)].departamento)
`);

const productos = await sanityClient.fetch(
  `*[_type == "producto" && defined(categoria) && categoria->departamento == $departamento]{
    "slug": slug.current,
    titulo,
    precio,
    descripcion,
    altTexto,
    imagenPrincipal,
    edicion,
    palabrasClave,
    agotado,
    "categoriaTitulo": categoria->titulo
  }`,
  { departamento }
);

const configWhatsApp = await obtenerConfiguracionWhatsApp();
const numeroWhatsApp = numeroWhatsAppParaDepartamento(departamento, configWhatsApp);

const porCategoria = productos.reduce((acc: any, producto: any) => {
  const cat = producto.categoriaTitulo || 'Sin categoría';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(producto);
  return acc;
}, {});

const categorias = Object.keys(porCategoria);
const LIMITE_INICIAL = 4;
const TANDA_VER_MAS = 24;
const nombreDepartamentoTexto = nombreDepartamento(departamento, configWhatsApp);

function quitarAcentos(texto: string): string {
  return texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

function normalizarParaComparar(texto: string): string {
  let t = quitarAcentos(texto.toLowerCase().trim());
  if (t.endsWith('s') && t.length > 3) t = t.slice(0, -1);
  return t;
}

function esRedundante(categoria: string, departamentoTexto: string): boolean {
  return normalizarParaComparar(categoria) === normalizarParaComparar(departamentoTexto);
}

function generarDescripcionDepartamento(
  nombreDepto: string,
  categoriasConConteo: { titulo: string; total: number }[]
): string {
  const LIMITE = 3;

  const nombresExpandidos: { nombre: string; total: number }[] = [];
  for (const cat of categoriasConConteo) {
    const partes = cat.titulo.split('/').map((p) => p.trim()).filter(Boolean);
    for (const parte of partes) {
      nombresExpandidos.push({ nombre: parte, total: cat.total });
    }
  }

  const nombresUtiles = nombresExpandidos.filter(
    (n) => !esRedundante(n.nombre, nombreDepto)
  );

  const vistos = new Set<string>();
  const nombresUnicos = nombresUtiles.filter((n) => {
    const clave = normalizarParaComparar(n.nombre);
    if (vistos.has(clave)) return false;
    vistos.add(clave);
    return true;
  });

  nombresUnicos.sort((a, b) => b.total - a.total);

  const totalUnicos = nombresUnicos.length;
  const seleccionados = nombresUnicos.slice(0, LIMITE).map((n) => n.nombre);

  if (seleccionados.length === 0) {
    return `Explora nuestro catálogo de ${nombreDepto} en HG Store MX.`;
  }

  if (seleccionados.length === 1) {
    return `Descubre nuestra selección de ${seleccionados[0]} en ${nombreDepto} — catálogo completo en HG Store MX.`;
  }

  const hayMas = totalUnicos > LIMITE;

  if (seleccionados.length === 2 && !hayMas) {
    return `Encuentra ${seleccionados[0]} y ${seleccionados[1]} en ${nombreDepto} — catálogo completo en HG Store MX.`;
  }

  const todosMenosUltimo = seleccionados.slice(0, -1).join(', ');
  const ultimo = seleccionados[seleccionados.length - 1];
  const cierre = hayMas ? `${todosMenosUltimo}, ${ultimo} y más` : `${todosMenosUltimo} y ${ultimo}`;

  return `Encuentra ${cierre} en ${nombreDepto} — catálogo completo en HG Store MX.`;
}

const categoriasConConteo = categorias.map((titulo) => ({
  titulo,
  total: porCategoria[titulo].length,
}));

const descripcionDepartamento = generarDescripcionDepartamento(nombreDepartamentoTexto, categoriasConConteo);

const productoDestacadoDepto = productos.find((p: any) => p.imagenPrincipal);
const imagenDepartamento = productoDestacadoDepto
  ? urlFor(productoDestacadoDepto.imagenPrincipal).width(1200).height(630).fit('crop').auto('format').url()
  : undefined;

const productosEnOrden = categorias.flatMap((cat) => porCategoria[cat]);
const datosItemList = {
  '@context': 'https://schema.org/',
  '@type': 'ItemList',
  itemListElement: productosEnOrden.map((p: any, indice: number) => ({
    '@type': 'ListItem',
    position: indice + 1,
    url: `https://hgstoremx.com/productos/${p.slug}/`,
  })),
};
---
<Layout titulo={`${nombreDepartamentoTexto} - HG Store MX`} descripcion={descripcionDepartamento} imagen={imagenDepartamento}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(datosItemList)} />
  </Fragment>

  <MenuHamburguesa departamentos={todosDepartamentos} configWhatsApp={configWhatsApp}>
    <BotonCarrito slot="carrito" />
  </MenuHamburguesa>
  <PanelCarrito numeroDefault={configWhatsApp.numeroDefault} />

  <nav aria-label="Ruta de navegación" class="flex items-center gap-1.5 px-6 py-2 text-sm border-b border-neutral-100">
    <a href="/" class="text-neutral-500 hover:text-neutral-900">Inicio</a>
    <span class="text-neutral-300" aria-hidden="true">&rsaquo;</span>
    <span class="font-medium text-neutral-900">{nombreDepartamentoTexto}</span>
  </nav>

  <section class="px-6 pt-8 pb-2 text-center max-w-2xl mx-auto">
    <h1 class="text-3xl font-semibold tracking-tight text-neutral-900">
      {nombreDepartamentoTexto}
    </h1>
  </section>

  <div class="sticky z-10 bg-white border-b border-neutral-100 px-6 py-3" style="top: var(--alto-header, 68px);">
    <div class="max-w-2xl mx-auto">
      <!--
        Campo de búsqueda pensado para celular (iPhone y Android):
        - type/inputmode/enterkeyhint="search": teclado de búsqueda con tecla "Buscar".
        - autocomplete/autocorrect/autocapitalize/spellcheck apagados: sin sugerencias de
          contactos, sin MAYÚSCULA inicial forzada y sin autocorrector cambiando nombres.
        - name="search": Safari ignora autocomplete="off" para "Autorrellenar contacto";
          que el nombre diga "search" es lo que lo hace tratarlo como búsqueda.
        - text-base en celular (16px): Safari en iPhone no hace zoom al tocarlo.
      -->
      <input
        type="search"
        id="buscador"
        name="search"
        inputmode="search"
        enterkeyhint="search"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="none"
        spellcheck="false"
        aria-label="Buscar productos"
        placeholder={`Buscar en ${nombreDepartamentoTexto}...`}
        class="w-full appearance-none rounded-full border border-neutral-200 px-6 py-3 text-base sm:text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-neutral-900"
      />
      {categoriasConConteo.length > 1 && (
        <div id="fila-categorias" class="mt-2 flex gap-2 overflow-x-auto pb-1" style="scrollbar-width: none;">
          {categoriasConConteo.map((cat, index) => (
            <button
              type="button"
              class={`chip-categoria shrink-0 rounded-full border px-3 py-1.5 text-xs whitespace-nowrap transition-colors ${
                index === 0
                  ? 'bg-neutral-900 border-neutral-900 text-white'
                  : 'border-neutral-200 text-neutral-600 hover:border-neutral-400'
              }`}
              data-categoria={cat.titulo}
            >
              {cat.titulo}
            </button>
          ))}
        </div>
      )}
    </div>
  </div>

  <p class="px-6 pt-5 max-w-2xl mx-auto text-center text-base leading-relaxed text-neutral-600">
    Para pedir cualquier producto, agrégalo al carrito y envía tu lista por WhatsApp. El pago y la entrega se acuerdan ahí; en ningún momento se te solicitará ningún pago en este sitio.
  </p>

  <main class="px-6 pt-8 pb-20 max-w-5xl mx-auto space-y-10" data-tanda={TANDA_VER_MAS}>
    <div id="estado-busqueda" class="hidden">
      <p id="aviso-correccion" class="hidden text-sm text-neutral-700 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 mb-4"></p>
      <p id="contador-resultados" class="text-sm text-neutral-500"></p>
      <div id="sin-resultados" class="hidden text-center py-10 max-w-md mx-auto" data-numero={numeroWhatsApp}>
        <p class="text-neutral-700">No encontramos <span id="termino-sin-resultados" class="font-semibold"></span> en {nombreDepartamentoTexto}.</p>
        <p class="text-sm text-neutral-500 mt-2">Tenemos más inventario del que está publicado. Pregúntanos y te decimos si lo tenemos o si lo podemos conseguir.</p>
        <a id="boton-preguntar-whatsapp" href="#" target="_blank" rel="noopener" class="mt-5 inline-flex items-center justify-center rounded-md bg-neutral-900 px-6 py-3 text-sm font-medium text-white hover:bg-neutral-700 transition-colors">
          ¿No lo encuentras? Pregúntanos por WhatsApp
        </a>
        <button id="boton-limpiar-busqueda" type="button" class="mt-3 block mx-auto text-sm text-neutral-500 underline">
          Ver todo {nombreDepartamentoTexto}
        </button>
      </div>
    </div>
    {categorias.map((cat) => {
      const productosDeCategoria = porCategoria[cat];
      const hayExtras = productosDeCategoria.length > LIMITE_INICIAL;
      return (
        <div
          class="categoria-contenedor"
          data-categoria={cat}
          data-seccion-nombre={cat}
          data-total={productosDeCategoria.length}
          data-visibles={LIMITE_INICIAL}
          style="scroll-margin-top: 190px;"
        >
          <h3 class="text-lg font-semibold text-neutral-900 mb-4 pb-2 border-b-2 border-neutral-900 inline-block pr-6">{cat}</h3>
          <div class="grid-categoria grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-8">
            {productosDeCategoria.map((producto: any, index: number) => (
              <div
                class={`producto-item ${index >= LIMITE_INICIAL ? 'producto-extra' : ''}`}
                data-indice={index}
                style={index >= LIMITE_INICIAL ? 'display: none;' : ''}
                data-titulo={prepararTexto(producto.titulo, producto.palabrasClave).titulo}
                data-claves={prepararTexto(producto.titulo, producto.palabrasClave).claves}
                data-agotado={producto.agotado ? 'true' : 'false'}
              >
                <ProductCard
                  slug={producto.slug}
                  titulo={producto.titulo}
                  precio={producto.precio}
                  imagenPrincipal={producto.imagenPrincipal}
                  descripcion={producto.descripcion}
                  altTexto={producto.altTexto}
                  edicion={producto.edicion}
                  numeroWhatsApp={numeroWhatsApp}
                  agotado={producto.agotado}
                />
              </div>
            ))}
          </div>
          {hayExtras && (
            <div class="mt-6 flex flex-col items-center gap-2">
              <button
                type="button"
                class="boton-ver-mas w-full sm:w-auto rounded-full bg-neutral-100 px-8 py-3.5 text-base font-semibold text-neutral-900 hover:bg-neutral-200 active:bg-neutral-300 transition"
              >
                Ver {Math.min(TANDA_VER_MAS, productosDeCategoria.length - LIMITE_INICIAL)} más
              </button>
              <p class="texto-contador text-sm text-neutral-400">
                Mostrando {LIMITE_INICIAL} de {productosDeCategoria.length}
              </p>
            </div>
          )}
        </div>
      );
    })}

    {categorias.length === 0 && (
      <p class="text-center text-neutral-400">Todavía no hay productos en este departamento.</p>
    )}
  </main>

  <Footer departamentos={todosDepartamentos} configWhatsApp={configWhatsApp} />
</Layout>

<style>
  @keyframes pista-scroll-categorias {
    0% { transform: translateX(0); }
    35% { transform: translateX(-18px); }
    65% { transform: translateX(3px); }
    100% { transform: translateX(0); }
  }
  #fila-categorias.mostrar-pista {
    animation: pista-scroll-categorias 0.9s ease-in-out 400ms 1;
  }
</style>

<script>
  import { buscar, productosDesdeDom, linkPreguntarPorWhatsApp, crearRegistradorBusquedas } from '../../lib/buscador';

  const input = document.getElementById('buscador') as HTMLInputElement;
  const TANDA_VER_MAS = Number(document.querySelector('main')?.dataset.tanda) || 24;

  function actualizarBotonYContador(contenedor: HTMLElement) {
    const total = Number(contenedor.dataset.total || '0');
    const visibles = Number(contenedor.dataset.visibles || '0');
    const boton = contenedor.querySelector<HTMLButtonElement>('.boton-ver-mas');
    const contador = contenedor.querySelector<HTMLElement>('.texto-contador');

    if (contador) {
      contador.style.display = '';
      contador.textContent = `Mostrando ${visibles} de ${total}`;
    }

    if (!boton) return;
    if (visibles >= total) {
      boton.style.display = 'none';
    } else {
      boton.style.display = '';
      boton.textContent = `Ver ${Math.min(TANDA_VER_MAS, total - visibles)} más`;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.boton-ver-mas').forEach((boton) => {
    boton.addEventListener('click', () => {
      const contenedor = boton.closest('.categoria-contenedor') as HTMLElement;
      if (!contenedor) return;

      const total = Number(contenedor.dataset.total || '0');
      const visiblesAntes = Number(contenedor.dataset.visibles || '0');
      const nuevosVisibles = Math.min(visiblesAntes + TANDA_VER_MAS, total);

      contenedor.querySelectorAll<HTMLElement>('.producto-item').forEach((item) => {
        const indice = Number(item.dataset.indice || '0');
        if (indice < nuevosVisibles) item.style.display = '';
      });

      contenedor.dataset.visibles = String(nuevosVisibles);
      actualizarBotonYContador(contenedor);
    });
  });

  // Tecla "Buscar"/Intro del teclado: la búsqueda ya se aplicó al escribir;
  // solo se cierra el teclado para que se vean los resultados.
  input?.addEventListener('keydown', (evento) => {
    if (evento.key === 'Enter') {
      evento.preventDefault();
      input.blur();
      registrador.ahora(input.value, ultimaCantidad);
    }
  });

  const productosBuscables = productosDesdeDom('.producto-item');
  const registrador = crearRegistradorBusquedas(`catalogo:${location.pathname.split('/')[2] || ''}`);
  const estadoBusqueda = document.getElementById('estado-busqueda');
  const avisoCorreccion = document.getElementById('aviso-correccion');
  const contadorResultados = document.getElementById('contador-resultados');
  const sinResultados = document.getElementById('sin-resultados');
  const terminoSinResultados = document.getElementById('termino-sin-resultados');
  const botonPreguntar = document.getElementById('boton-preguntar-whatsapp') as HTMLAnchorElement | null;
  const botonLimpiar = document.getElementById('boton-limpiar-busqueda');
  const filaChips = document.getElementById('fila-categorias');
  const contenedoresCategoria = Array.from(document.querySelectorAll<HTMLElement>('.categoria-contenedor'));
  let ultimaCantidad = 0;

  /** Regresa cada producto a su lugar original dentro de su categoría. */
  function restaurarOrdenOriginal() {
    contenedoresCategoria.forEach((cat) => {
      const grid = cat.querySelector<HTMLElement>('.grid-categoria');
      if (!grid) return;
      Array.from(grid.querySelectorAll<HTMLElement>('.producto-item'))
        .sort((a, b) => Number(a.dataset.indice || 0) - Number(b.dataset.indice || 0))
        .forEach((item) => grid.appendChild(item));
    });
  }

  function aplicarBusqueda(consulta: string) {
    const hayBusqueda = consulta !== '';
    estadoBusqueda?.classList.toggle('hidden', !hayBusqueda);
    if (filaChips) filaChips.style.display = hayBusqueda ? 'none' : '';

    if (!hayBusqueda) {
      restaurarOrdenOriginal();
      contenedoresCategoria.forEach((cat) => {
        cat.style.display = '';
        const visibles = Number(cat.dataset.visibles || '0');
        cat.querySelectorAll<HTMLElement>('.producto-item').forEach((item) => {
          const indice = Number(item.dataset.indice || '0');
          item.style.display = indice < visibles ? '' : 'none';
        });
        actualizarBotonYContador(cat);
      });
      return;
    }

    const { resultados, correccion } = buscar(productosBuscables, consulta);
    ultimaCantidad = resultados.length;

    // Ocultar todo y mostrar solo lo que coincide, en el orden del buscador
    // (disponibles primero), dentro de su propia categoría.
    productosBuscables.forEach((p) => (p.dato.style.display = 'none'));
    resultados.forEach((p) => {
      p.dato.style.display = '';
      p.dato.parentElement?.appendChild(p.dato);
    });

    contenedoresCategoria.forEach((cat) => {
      const tieneVisibles = Array.from(cat.querySelectorAll<HTMLElement>('.producto-item')).some(
        (item) => item.style.display !== 'none'
      );
      cat.style.display = tieneVisibles ? '' : 'none';
    });
    document.querySelectorAll<HTMLButtonElement>('.boton-ver-mas').forEach((boton) => {
      boton.style.display = 'none';
    });
    document.querySelectorAll<HTMLElement>('.texto-contador').forEach((contador) => {
      contador.style.display = 'none';
    });

    if (avisoCorreccion) {
      avisoCorreccion.classList.toggle('hidden', !correccion);
      avisoCorreccion.textContent = correccion
        ? `No encontramos “${consulta}”. Mostrando resultados para “${correccion}”.`
        : '';
    }
    if (contadorResultados) {
      const n = resultados.length;
      contadorResultados.textContent = n > 0 ? `${n} resultado${n !== 1 ? 's' : ''} para "${correccion || consulta}"` : '';
    }
    if (sinResultados) {
      sinResultados.classList.toggle('hidden', resultados.length > 0);
      if (terminoSinResultados) terminoSinResultados.textContent = `“${consulta}”`;
      if (botonPreguntar) botonPreguntar.href = linkPreguntarPorWhatsApp(sinResultados.dataset.numero || '', consulta);
    }

    registrador.programar(consulta, resultados.length);
  }

  input?.addEventListener('input', () => {
    aplicarBusqueda(input.value.trim());
  });

  botonPreguntar?.addEventListener('click', () => {
    if (input) registrador.ahora(input.value, 0);
  });

  botonLimpiar?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    aplicarBusqueda('');
  });

  const CLASES_CHIP_ACTIVO = ['bg-neutral-900', 'border-neutral-900', 'text-white'];
  const CLASES_CHIP_INACTIVO = ['border-neutral-200', 'text-neutral-600', 'hover:border-neutral-400'];

  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip-categoria'));
  const secciones = Array.from(document.querySelectorAll<HTMLElement>('[data-seccion-nombre]'));

  function activarChip(nombreCategoria: string) {
    chips.forEach((chip) => {
      const activo = chip.dataset.categoria === nombreCategoria;
      chip.classList.remove(...(activo ? CLASES_CHIP_INACTIVO : CLASES_CHIP_ACTIVO));
      chip.classList.add(...(activo ? CLASES_CHIP_ACTIVO : CLASES_CHIP_INACTIVO));
      if (activo) {
        chip.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    });
  }

  let bloqueadoPorClic = false;
  let temporizadorDesbloqueo: ReturnType<typeof setTimeout> | undefined;

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const nombre = chip.dataset.categoria || '';
      const seccion = secciones.find((s) => s.dataset.seccionNombre === nombre);
      if (!seccion) return;

      bloqueadoPorClic = true;
      activarChip(nombre);
      seccion.scrollIntoView({ behavior: 'smooth', block: 'start' });

      clearTimeout(temporizadorDesbloqueo);
      temporizadorDesbloqueo = setTimeout(() => {
        bloqueadoPorClic = false;
      }, 700);
    });
  });

  const filaCategorias = document.getElementById('fila-categorias');
  if (filaCategorias && filaCategorias.scrollWidth > filaCategorias.clientWidth) {
    filaCategorias.classList.add('mostrar-pista');
  }

  if (chips.length > 0 && secciones.length > 1) {
    const observador = new IntersectionObserver(
      (entradas) => {
        if (bloqueadoPorClic) return;
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            const nombre = (entrada.target as HTMLElement).dataset.seccionNombre || '';
            activarChip(nombre);
          }
        });
      },
      { rootMargin: '-40% 0px -40% 0px', threshold: 0 }
    );
    secciones.forEach((seccion) => observador.observe(seccion));
  }
</script>
