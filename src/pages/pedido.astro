---
export const prerender = false;

import { sanityClient, urlFor } from '../lib/sanity';
import Layout from '../layouts/Layout.astro';

const parametroProductos = Astro.url.searchParams.get('productos') || '';
const slugs = parametroProductos
  .split(',')
  .map((s) => s.trim())
  .filter(Boolean);

const productos = slugs.length > 0
  ? await sanityClient.fetch(
      `*[_type == "producto" && slug.current in $slugs]{
        "slug": slug.current,
        titulo,
        precio,
        imagenPrincipal,
        edicion
      }`,
      { slugs }
    )
  : [];

// Conserva el orden en que el cliente los agregó al carrito
const productosOrdenados = slugs
  .map((slug) => productos.find((p: any) => p.slug === slug))
  .filter(Boolean);

const total = productosOrdenados.reduce((suma: number, p: any) => suma + (p.precio || 0), 0);
---
<Layout titulo="Resumen de pedido - HG Shop MX" noIndex={true}>
  <section class="px-6 py-10 max-w-3xl mx-auto">
    <h1 class="text-2xl font-semibold text-neutral-900 mb-1">Resumen del pedido</h1>
    <p class="text-sm text-neutral-500 mb-8">
      {productosOrdenados.length} producto{productosOrdenados.length === 1 ? '' : 's'} solicitado{productosOrdenados.length === 1 ? '' : 's'}
    </p>

    {productosOrdenados.length === 0 && (
      <p class="text-neutral-400">No se encontraron productos para este pedido.</p>
    )}

    <ul class="space-y-4">
      {productosOrdenados.map((producto: any) => (
        <li class="flex items-center gap-4 border border-neutral-100 rounded-lg p-3">
          <div class="w-16 h-16 flex-shrink-0 overflow-hidden rounded-md bg-neutral-50">
            <img
              src={urlFor(producto.imagenPrincipal).width(150).url()}
              alt={producto.titulo}
              class="w-full h-full object-contain"
            />
          </div>
          <div class="flex-1 min-w-0">
            <a href={`/productos/${producto.slug}`} class="text-sm font-medium text-neutral-900 hover:underline line-clamp-2">
              {producto.titulo}{producto.edicion ? ` (${producto.edicion})` : ''}
            </a>
            <p class="text-sm text-neutral-600 mt-1">${producto.precio} MXN</p>
          </div>
        </li>
      ))}
    </ul>

    {productosOrdenados.length > 0 && (
      <div class="mt-8 pt-4 border-t border-neutral-200 flex items-center justify-between">
        <span class="text-sm font-medium text-neutral-500">Total estimado</span>
        <span class="text-lg font-semibold text-neutral-900">${total} MXN</span>
      </div>
    )}
  </section>
</Layout>
