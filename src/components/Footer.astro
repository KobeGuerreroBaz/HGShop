---
import { nombreDepartamento } from '../lib/sanity';

interface Props {
  departamentos: string[];
  configWhatsApp: {
    numeroDefault: string;
    asignaciones: { departamento: string; numero: string; nombreBonito?: string }[];
  };
}
const { departamentos, configWhatsApp } = Astro.props;

const TEXTO_ENTREGA = 'Entrega personal en Monterrey, envío disponible a toda la República Mexicana';
const linkWhatsApp = `https://wa.me/${configWhatsApp.numeroDefault}`;
const anioActual = new Date().getFullYear();
---
<footer class="mt-16 border-t border-neutral-100 bg-neutral-50">
  <div class="max-w-5xl mx-auto px-6 py-10">
    <div>
      <h2 class="text-sm font-semibold text-neutral-900">Departamentos</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {departamentos.map((depto) => (
          <a
            href={`/catalogo/${depto}/`}
            class="rounded-full border border-neutral-200 px-3 py-1 text-xs text-neutral-600 hover:border-neutral-400 hover:text-neutral-900 transition-colors"
          >
            {nombreDepartamento(depto, configWhatsApp)}
          </a>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:gap-12">
      <div>
        <h2 class="text-sm font-semibold text-neutral-900">Cómo funciona</h2>
        <ol class="mt-3 space-y-2 text-sm text-neutral-600 list-decimal list-inside">
          <li>Agrega los productos que te interesan al carrito.</li>
          <li>Envía tu lista por WhatsApp.</li>
          <li>Acuerdan pago y entrega directo en el chat.</li>
        </ol>
        <p class="mt-3 text-sm text-neutral-600">
          En ningún momento se te solicitará ningún pago en este sitio.
        </p>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-900">Entrega</h2>
        <p class="mt-3 text-sm text-neutral-600">{TEXTO_ENTREGA}</p>
        <a
          href={linkWhatsApp}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center justify-center rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700 transition-colors"
        >
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-neutral-100">
    <p class="max-w-5xl mx-auto px-6 py-4 text-xs text-neutral-400 text-center">
      © {anioActual} HG Store MX
    </p>
  </div>
</footer>
