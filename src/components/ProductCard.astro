---
import { urlFor } from '../lib/sanity';

interface Props {
  slug: string;
  titulo: string;
  precio?: number | null;
  imagenPrincipal: any;
  descripcion?: string;
  altTexto?: string;
  edicion?: string;
  numeroWhatsApp: string;
  agotado?: boolean;
}

const { slug, titulo, precio, imagenPrincipal, descripcion, altTexto, numeroWhatsApp, agotado } = Astro.props;

const imageUrl = urlFor(imagenPrincipal).width(400).auto('format').url();
const textoAlt = altTexto || titulo;
---
<div class="w-full" data-tarjeta-producto>
  <a href={`/productos/${slug}/`} class="block">
    <div class="aspect-square w-full overflow-hidden rounded-lg bg-neutral-50 border border-neutral-100 relative">
      <img
        src={imageUrl}
        alt={textoAlt}
        class={`w-full h-full object-contain ${agotado ? 'opacity-50 grayscale' : ''}`}
        loading="lazy"
      />
    </div>
    <h3 class="mt-3 text-sm font-medium text-neutral-900 line-clamp-2">{titulo}</h3>
    {descripcion && (
      <p class="mt-1 text-xs text-neutral-500 line-clamp-2">{descripcion}</p>
    )}
  </a>
  {precio != null ? (
    <p class="mt-1 text-base font-semibold text-neutral-900">${precio} MXN</p>
  ) : (
    <p class="mt-1 text-base font-semibold text-neutral-500">Consultar precio</p>
  )}

  {agotado ? (
    <div class="mt-2 flex items-center justify-center rounded-md bg-neutral-100 border border-neutral-200 px-3 py-2 text-sm font-semibold text-neutral-500 tracking-wide">
      AGOTADO
    </div>
  ) : (
    <div class="mt-2">
      <button
        type="button"
        class="btn-agregar-carrito w-full inline-flex items-center justify-center rounded-md border border-neutral-900 bg-neutral-900 px-3 py-2 text-sm font-medium text-white hover:bg-neutral-700 transition-colors"
        data-slug={slug}
        data-titulo={titulo}
        data-numero={numeroWhatsApp}
      >
        Agregar al carrito
      </button>
    </div>
  )}
</div>

<script>
  import {
    estaEnCarrito,
    agregarAlCarrito,
    quitarDelCarrito,
  } from '../lib/carrito';

  // Dos aspectos completos del botón. Se cambian juntos (fondo, texto y hover) para que
  // el texto nunca quede del mismo color que el fondo, ni siquiera al pasar el cursor.
  const CLASES_AGREGAR = ['bg-neutral-900', 'text-white', 'hover:bg-neutral-700'];
  const CLASES_EN_CARRITO = ['bg-white', 'text-neutral-900', 'hover:bg-neutral-100'];

  function actualizarTarjeta(contenedor: HTMLElement) {
    const btnCarrito = contenedor.querySelector<HTMLButtonElement>('.btn-agregar-carrito');
    const slug = btnCarrito?.dataset.slug;
    if (!btnCarrito || !slug) return;

    const enCarrito = estaEnCarrito(slug);
    btnCarrito.textContent = enCarrito ? 'Quitar del carrito' : 'Agregar al carrito';
    btnCarrito.classList.remove(...(enCarrito ? CLASES_AGREGAR : CLASES_EN_CARRITO));
    btnCarrito.classList.add(...(enCarrito ? CLASES_EN_CARRITO : CLASES_AGREGAR));
  }

  function actualizarTodasLasTarjetas() {
    document.querySelectorAll<HTMLElement>('[data-tarjeta-producto]').forEach(actualizarTarjeta);
  }

  document.addEventListener('DOMContentLoaded', () => {
    actualizarTodasLasTarjetas();

    document.querySelectorAll<HTMLButtonElement>('.btn-agregar-carrito').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.slug!;
        const titulo = btn.dataset.titulo!;
        const numeroWhatsApp = btn.dataset.numero!;

        if (estaEnCarrito(slug)) {
          quitarDelCarrito(slug);
        } else {
          agregarAlCarrito({ slug, titulo, numeroWhatsApp });
        }

        actualizarTodasLasTarjetas();
        document.dispatchEvent(new CustomEvent('carrito-actualizado'));
      });
    });
  });

  document.addEventListener('carrito-actualizado', actualizarTodasLasTarjetas);
</script>
