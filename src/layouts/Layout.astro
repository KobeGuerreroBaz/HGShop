---
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  noIndex?: boolean;
  canonical?: string;
}

const {
  titulo = "HG Shop MX",
  descripcion = "Catálogo de productos - HG Shop MX",
  imagen,
  noIndex = false,
  canonical,
} = Astro.props;

const urlCanonica = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#171717" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    {imagen && <meta property="og:image" content={imagen} />}

    <meta name="twitter:card" content={imagen ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    {imagen && <meta name="twitter:image" content={imagen} />}

    <slot name="head" />
  </head>
  <body class="bg-white text-neutral-900 font-sans antialiased">
    <slot />
  </body>
</html>
